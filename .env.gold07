# Fake RSVP backend used ONLY by the GOLD-07 cascade harness
# (hostv2/e2e/gold07RsvpCascade.spec.mjs). The host never resolves; every
# request is intercepted by Playwright. No real backend, no real credentials.
#
# WHY ITS OWN BUNDLE. The ordinary e2e build bakes no REACT_APP_API_BASE_URL at
# all, so isRsvpApiConfigured() is false and the entire backend leg of the RSVP
# cascade — submitRsvp, fetchEventRsvps, and the snake_case normalisation in
# HostShellV2 — is unreachable from the browser suite. Baking an API base into
# the SHARED bundle would change what all 126 specs run against; fixtures.mjs
# already records what happened the last time a truthy API base reached every
# surface at once. Same reasoning, and the same shape, as .env.synctest.
REACT_APP_API_BASE_URL=https://gold07-mock.invalid
# Makes hasPlannerAuth() true without a Supabase session, so the host read-back
# is actually attempted. A planner read-back with no credential returns [] and
# never leaves the browser (lib/api/rsvp.js:38) — which would make the leg a
# silent no-op rather than a test.
REACT_APP_PLANNER_TOKEN=gold07-token-not-a-real-secret
