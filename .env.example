# NGW Events — config (Create React App uses REACT_APP_* prefix).
# Copy this file to .env.local (which is gitignored) and fill in your values.
#
# ─── Endpoint consistency ─────────────────────────────────────────────────────
# Three URL groups must stay aligned for sign-in + invites + share links to
# work in dev:
#   1. WHERE THE APP IS SERVED FROM  (your browser bar)
#        localhost:3000          (default `npm start`)
#        192.168.1.230:3000      (LAN dev, e.g. for phone testing)
#        https://your-tunnel...  (ngrok/cloudflared)
#   2. WHERE SUPABASE REDIRECTS TO   (magic links + invites)
#        Controlled by REACT_APP_AUTH_REDIRECT below, OR window.location.origin
#        Must also appear in Supabase → Authentication → URL Configuration
#   3. WHERE SHARE LINKS POINT       (RSVP, vendor brief)
#        Computed at runtime from window.location.origin — always matches #1
#
# Rule: visit the app from the same URL your phone/teammate can reach, then
# match REACT_APP_AUTH_REDIRECT + Supabase allowlist to that URL.
#
# ── Supabase (Settings → API) ────────────────────────────────────────────────
#   - Project URL          → REACT_APP_SUPABASE_URL
#   - Project API key (anon / publishable) → REACT_APP_SUPABASE_ANON_KEY
#   NEVER put the service_role / secret key here — it would leak into the public bundle.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Optional: force the magic-link redirect URL (otherwise derived from
# window.location.origin). Set this when developing from a LAN IP or behind
# a tunnel — Supabase silently falls back to the project's Site URL when
# `emailRedirectTo` isn't on the allowlist, so the link in the email would
# end up pointing at localhost and be unusable on phones / other devices.
# Must match an entry in Supabase → Authentication → URL Configuration.
# Example: REACT_APP_AUTH_REDIRECT=http://192.168.1.230:3000/
REACT_APP_AUTH_REDIRECT=

# ── Communication backend (FastAPI) ──────────────────────────────────────────
# Public base URL of the deployed comms API. Safe to commit (lives in demo/.env).
REACT_APP_API_BASE_URL=https://ngw-events-api.onrender.com

# TEMPORARY planner dev-gate token. Must match the backend's PLANNER_DEV_TOKEN.
# SECRET — put it ONLY in .env.local for local dev. Do NOT commit it and do NOT
# bake it into the public GitHub Pages build (it would be readable by anyone).
# When unset, the Communication tab still reads the client channel but planner
# writes / the internal channel are disabled until Supabase Auth replaces this gate.
REACT_APP_PLANNER_TOKEN=

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
# Optional. Sentry → Project → Settings → Client Keys (DSN). A DSN is non-secret.
# When unset, Sentry is a no-op (nothing is sent). Safe to leave blank for the demo.
REACT_APP_SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════════════════
#  Full REACT_APP_* inventory — added 2026-07-30 (Release Integrity C2).
#
#  21 of the 27 variables referenced by application code (src/, hostv2/src/)
#  were undocumented here. Every name
#  below is real (grepped from src/ and hostv2/src/). NO VALUES are committed;
#  anything secret is marked and belongs only in .env.local (gitignored).
#
#  Reminder: CRA bakes every REACT_APP_* into the PUBLIC bundle at build time.
#  Nothing here is hidden from users — treat "secret" as "do not ship at all".
# ═══════════════════════════════════════════════════════════════════════════

# ── Third-party keys (PUBLIC once built — restrict them by referrer/domain) ──
# Optional. Unset ⇒ the corresponding feature degrades to its offline path.
REACT_APP_OPENWEATHER_KEY=
REACT_APP_GOOGLE_MAPS_KEY=
REACT_APP_FDA_API_KEY=

# ── Product analytics (optional; unset ⇒ no-op) ──────────────────────────────
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=

# ── Access / rollout flags ───────────────────────────────────────────────────
# Optional. Unset ⇒ the safe default shown in brackets.
REACT_APP_INVITE_ONLY=          # [off] gate signup behind an invite
REACT_APP_ENABLE_GOOGLE_AUTH=   # [off] show the Google sign-in button
REACT_APP_BILLING_LIVE=         # [off] live billing instead of test mode

# ── DEVELOPMENT ONLY — never set in a deployed build ─────────────────────────
# REACT_APP_AUTH_BYPASS skips planner sign-in entirely. If it were ever built
# into the Pages bundle it would ship an unauthenticated app to the public.
# REACT_APP_BYPASS_ROLE picks the role that bypass assumes.
REACT_APP_AUTH_BYPASS=
REACT_APP_BYPASS_ROLE=

# ── Progressive-interface feature flags (all optional; unset ⇒ off) ──────────
# Internal rollout switches for host-shell surfaces. Safe to leave blank.
REACT_APP_PI_ATTENTION=
REACT_APP_PI_CONFIDENCE=
REACT_APP_PI_DECISIONS=
REACT_APP_PI_IDENTITY=
REACT_APP_PI_LABELS=
REACT_APP_PI_MEMORY=
REACT_APP_PI_MOMENTS=
REACT_APP_PI_NAV=
REACT_APP_PI_PLANV2=
REACT_APP_PI_SHELL=
REACT_APP_PI_VOICE=

# ═══════════════════════════════════════════════════════════════════════════
#  BUILD MODES + PROHIBITED VARIABLES — 2026-07-31 (Slice D3)
#
#  Every variable above is compiled into the PUBLIC bundle. Two explicit modes,
#  enforced by scripts/validate-production-config.mjs:
#
#    --mode=verification   public config MAY be blank. Compiles and runs as the
#                          open, localStorage-only demo. NOT production-capable.
#    --mode=production     REQUIRES the three values below, or the build fails
#                          rather than silently degrading to that demo.
#
#  Required for a production release:
#      REACT_APP_API_BASE_URL, REACT_APP_SUPABASE_URL, REACT_APP_SUPABASE_ANON_KEY
#
#  PROHIBITED in any browser production build (the validator fails on them):
#      REACT_APP_PLANNER_TOKEN   shared planner write-gate — publishing it hands
#                                every visitor planner writes
#      REACT_APP_AUTH_BYPASS     skips sign-in entirely
#      REACT_APP_BYPASS_ROLE     the role that bypass assumes
#  ...plus service-role keys, provider secrets and database URLs under any
#  REACT_APP_ name. There is no such thing as a private REACT_APP_* value.
#
#  Full classification of all 27 variables, and where production values live in
#  GitHub: docs/release/PRODUCTION_CONFIG.md
# ═══════════════════════════════════════════════════════════════════════════
