{
  "name": "ngw-event-boss",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://twillis45.github.io/ngw-event-planner",
  "dependencies": {
    "@sentry/react": "^8.55.2",
    "@supabase/supabase-js": "^2.106.1",
    "papaparse": "^5.5.3",
    "posthog-js": "^1.379.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-scripts": "5.0.1",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "sync:hostv2": "node scripts/hostv2-artifact.mjs --sync",
    "gate:hostv2": "node scripts/hostv2-artifact.mjs --check",
    "matrix": "node scripts/matrix.mjs",
    "gate:cra": "node scripts/cra-build-gate.mjs",
    "gate:cra:update": "node scripts/cra-build-gate.mjs --update",
    "release": "npm run sync:hostv2 && npm run build",
    "deploy": "gh workflow run \"Deploy Pages (from source)\" --ref main -f release_profile=demo",
    "check:migrations": "node scripts/check-migrations.mjs",
    "grounding:audit": "node scripts/groundingAudit.mjs",
    "grounding:json": "node scripts/groundingAudit.mjs --json",
    "grounding:proteins": "node scripts/proteinCoverage.mjs",
    "knowledge:impact": "node scripts/knowledgeImpactIndex.mjs",
    "bake:knowledge": "node scripts/bake-published-knowledge.mjs",
    "gate:knowledge": "node scripts/bake-published-knowledge.mjs --check",
    "grounding:census": "node scripts/groundingCensus.mjs src/lib/playbooks/data",
    "design:build": "node scripts/build-design-lib.mjs && node scripts/check-design-dts.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:fast": "node scripts/verify-all.mjs --fast",
    "handoff:check": "node scripts/handoff-freshness.mjs",
    "handoff:stamp": "node scripts/handoff-freshness.mjs --stamp"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "esbuild": "^0.25.0"
  },
  "module": "./dist-design/index.mjs",
  "main": "./dist-design/index.cjs",
  "types": "./dist-design/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-design/index.d.ts",
      "import": "./dist-design/index.mjs",
      "require": "./dist-design/index.cjs"
    }
  }
}
