# Fake Supabase project AND fake RSVP backend, used ONLY by the signed-in reply
# harness (hostv2/e2e/aReplySurvivesTheSignInPull.spec.mjs). The host never
# resolves; every request is intercepted by Playwright. No real project, no
# real backend, no real credentials.
#
# WHY ITS OWN BUNDLE. Issue #100, D-7: a guest's reply merged on the host's
# device and was then overwritten by the sign-in pull. That needs BOTH halves at
# once — a signed-in Supabase session (synctest has it) and an RSVP API base
# for the read-back (gold07 has it) — and no existing bundle carries both.
# Baking either into a shared bundle changes what other specs run against (see
# .env.gold07), so this is the same shape as those two, not a widening of them.
REACT_APP_SUPABASE_URL=https://rsvpsync.supabase.co
REACT_APP_SUPABASE_ANON_KEY=rsvpsync-anon-key-not-a-real-secret
REACT_APP_API_BASE_URL=https://rsvpsync-mock.invalid
# Must ALSO be passed inline on the build command (see .env.synctest).
REACT_APP_AUTH_BYPASS=false
