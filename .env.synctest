# Fake Supabase project used ONLY by the cross-device sync harness
# (hostv2/e2e/crossDeviceSync.spec.mjs). The host never resolves; every request
# is intercepted by Playwright. No real project, no real credentials.
REACT_APP_SUPABASE_URL=https://synctest.supabase.co
REACT_APP_SUPABASE_ANON_KEY=synctest-anon-key-not-a-real-secret
# Must ALSO be passed inline on the build command: .env.local sets this true for
# dev and outranks .env.[mode] in Vite's precedence order.
REACT_APP_AUTH_BYPASS=false
