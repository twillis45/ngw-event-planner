-          <button type="button" className="ghost ivd-full" onClick={onSeeFull}>See the full invite</button>
+          <button type="button" className="ghost ivd-full" aria-expanded={full} aria-controls="ivd-pv-frame"
+            data-invite-full onClick={() => setFull((f) => !f)}>{full ? 'Show less' : 'See the full invite'}</button>
