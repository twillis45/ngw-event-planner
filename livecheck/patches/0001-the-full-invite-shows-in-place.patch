@@ -0,0 +1,78 @@
+// ─── THE FULL INVITE SHOWS IN PLACE (owner, iPad, 11/24/2026) ───────────────
+//
+// "Not showing full preview." The Invite page's live preview is a 440px
+// window, so the bottom of the invite (the reply buttons and below) was cut
+// off, and "See the full invite" opened the public ?rsvp= link in a new tab:
+// the SAVED invite, so a host who had just picked "At a glance" saw Classic
+// there (measured live on e1ff88b at 1194x834, 1024x768 and 390x844).
+//
+// Now the button opens the same preview to the whole invite, built from the
+// draft she is editing, and toggles back. No new tab. Made-up event; nothing
+// is sent (every API request is answered here).
+import { test, expect, dateIn, sheetSettled } from './fixtures.mjs';
+
+const API = 'https://e2e-mock.invalid';
+const EVENT = {
+  id: 'cust-full-invite', rsvpCode: 'full-invite-code-000001',
+  name: 'Rosa’s Harvest Dinner', type: 'Dinner Party', date: dateIn(2), startTime: '18:00', startTimeSource: 'host',
+  venueAddress: '42 Elm Ct', venueCity: 'Springfield', venueState: 'VA', venueZip: '22150',
+  hostName: 'Rosa Vale', rsvpDeadline: dateIn(1),
+  guestEstimate: 12, guestMode: 'count', guests: [], vendors: [], budget: [], timeline: [],
+};
+
+const openPanel = async (page) => {
+  await page.addInitScript((e) => {
+    if (sessionStorage.getItem('seeded')) return;
+    sessionStorage.setItem('seeded', '1');
+    localStorage.setItem('ngw-hostv2-custom-events', JSON.stringify([e]));
+    localStorage.setItem('ngw-hostv2-last-event', e.id);
+    localStorage.setItem('ngw-v2-splash-seen', new Date().toISOString());
+    localStorage.setItem('ngw-welcomed', '1'); localStorage.setItem('ngw-v2-welcomed', '1');
+  }, EVENT);
+  await page.route(`${API}/**`, (route) => route.fulfill({ status: 404, json: { detail: 'not found' } }));
+  await page.goto('?open=invite');
+  await expect(page.locator('#sheet-title')).toHaveText('Invite page', { timeout: 10_000 });
+  await sheetSettled(page);
+  await expect(page.locator('[data-invite-preview] .inv2-sheet')).toBeVisible();
+};
+
+const frame = (page) => page.evaluate(() => {
+  const f = document.querySelector('[data-invite-preview]');
+  return { clientH: f.clientHeight, scrollH: f.scrollHeight };
+});
+
+test('"See the full invite" opens the preview to the whole draft invite, in place, and closes again', async ({ page, context }) => {
+  await openPanel(page);
+  // Pick the layout that is NOT saved, so the full view must be the draft.
+  await page.getByRole('radiogroup', { name: 'Layout' }).getByRole('radio', { name: /At a glance/ }).click();
+  const pv = page.locator('[data-invite-preview]');
+  await expect(pv.locator('.inv2-sheet')).toHaveAttribute('data-invite-layout', 'glance');
+
+  const btn = page.getByRole('button', { name: 'See the full invite' });
+  await expect(btn).toHaveAttribute('aria-expanded', 'false');
+  const box = await btn.boundingBox();
+  expect(box.height).toBeGreaterThanOrEqual(44);
+
+  let opened = false;
+  context.on('page', () => { opened = true; });
+  await btn.click();
+
+  // The whole invite is in view: nothing clipped, the reply buttons and the
+  // notice below them inside the frame.
+  await expect(page.getByRole('button', { name: 'Show less' })).toHaveAttribute('aria-expanded', 'true');
+  await expect.poll(async () => { const f = await frame(page); return f.scrollH - f.clientH; }).toBeLessThanOrEqual(1);
+  await expect(pv.locator('.inv2-sheet')).toHaveAttribute('data-invite-layout', 'glance');
+  const fr = await pv.boundingBox();
+  for (const label of [/Yes, I.m in/i, /Maybe/i]) {
+    const r = await pv.getByRole('radio', { name: label }).first().boundingBox();
+    expect(r.y + r.height, `${label} inside the frame`).toBeLessThanOrEqual(fr.y + fr.height + 1);
+  }
+  await expect(pv).toContainText('Just a preview');
+  expect(opened, 'no new tab').toBe(false);
+  expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth + 1)).toBe(true);
+
+  // And back to the window.
+  await page.getByRole('button', { name: 'Show less' }).click();
+  await expect(page.getByRole('button', { name: 'See the full invite' })).toHaveAttribute('aria-expanded', 'false');
+  expect((await frame(page)).clientH).toBeLessThanOrEqual(441);
+});
